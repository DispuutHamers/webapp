<div class="bg-white dark:bg-gray-900 md:shadow md:rounded-lg md:p-4">
    <h2 class="text-hamers-red-400 text-xl font-bold">Quote</h2>
    <div class="flex items-center mt-2">
      <%= form_for @quote, html: { class: "w-full" } do |f| %>
        <%= render 'shared/error_messages', object: f.object %>
        <div>
          <div class="mt-1">
            <%= f.text_area :text,
                placeholder: 'Wat zei die lul of kut?',
                rows: 2,
                class: 'shadow-sm focus:ring-hamers-red-500 focus:border-hamers-red-500 mt-1 block w-full sm:text-sm border border-gray-300 dark:border-gray-700 
                  dark:bg-gray-800 dark:text-gray-200 rounded-md' %>
          </div>
        </div>
         <% users = User.all.reverse %>
        <div class="col-span-6 sm:col-span-3 relative" data-controller="user-select">
          <%= f.select :user_id, options_for_select(users.map { |user| [user.name, user.id] }, f.object.user_id),
                {}, class: select_classes, data: { user_select_target: 'select' } %>
          <div class="hidden" data-user-select-target="widget">
            <button type="button"
                    class="<%= select_classes %> flex items-center text-left"
                    aria-haspopup="listbox" aria-expanded="false"
                    data-user-select-target="button"
                    data-action="user-select#toggle">
              <img src="" alt="" class="h-8 w-8 rounded-full mr-2 flex-shrink-0" data-user-select-target="selectedAvatar">
              <span class="truncate" data-user-select-target="selectedName"></span>
            </button>
            <div class="hidden absolute z-20 mt-1 w-full bg-white dark:bg-gray-800 border border-gray-300 dark:border-gray-700 rounded-md shadow-lg"
                 data-user-select-target="panel">
              <div class="p-2">
                <input type="text" placeholder="Zoek een Hamer..." autocomplete="on"
                       class="block w-full py-1 px-2 border border-gray-300 dark:border-gray-700 dark:bg-gray-900 dark:text-gray-200 rounded-md sm:text-sm focus:ring-hamers-red-500 focus:border-hamers-red-500"
                       data-user-select-target="search"
                       data-action="input->user-select#filter keydown->user-select#keydown">
              </div>
              <ul class="max-h-60 overflow-auto py-1 sm:text-sm dark:text-gray-200" role="listbox">
                <% users.each do |user| %>
                  <li class="flex items-center px-3 py-2 cursor-pointer" role="option"
                      data-user-select-target="option"
                      data-value="<%= user.id %>"
                      data-label="<%= user.name %>"
                      data-action="click->user-select#select mouseenter->user-select#hover">
                    <%= gravatar_for user, size: 64, class: "h-8 w-8 rounded-full mr-2 flex-shrink-0" %>
                    <span class="truncate"><%= user.name %></span>
                  </li>
                <% end %>
                <li class="hidden px-3 py-2 text-gray-500" data-user-select-target="empty">Geen Hamer gevonden</li>
              </ul>
            </div>
          </div>
        </div>
        <div class="text-right mt-4 sm:w-full">
          <%= f.submit 'Citeer', class: submit_classes %>
        </div>
      <% end %>
    </div>
</div>
